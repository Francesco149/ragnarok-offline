<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="ragnarok-offline.stub" version="0.1.0.0" processorArchitecture="x86"/>
  <description>Starts Ragnarok Offline</description>
  <!-- asInvoker: no UAC prompt and no virtualization; RagnarokOffline.exe elevates itself when it must -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security><requestedPrivileges><requestedExecutionLevel level="asInvoker" uiAccess="false"/></requestedPrivileges></security>
  </trustInfo>
</assembly>
