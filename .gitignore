/target
# runtime state of a local server
/saves/
/logs/
*.log
# client files are copyrighted and live in ~/data/ragnarok-cd (mounted at /data)
/client/
*.grf
*.gpf
/dist/
/third_party/*
!/third_party/README.md
# `msiinfo export` dumps stream columns (Gravity's icons/bitmaps) into <Table>/ in the cwd
/Icon/
/Binary/
__pycache__/
# round-1 research: raw downloads and third-party dumps stay local (the report,
# its notes and excerpts are committed)
/research/agy-threads/*.txt
/research/agy-threads/*.json
/research/agy-threads/*.rar
/research/agy-threads/frames/
/research/agy-threads/report.md
# round 2: this table is the client's own pettalktable.xml and msgstringtable.txt
# (Gravity's text), row for row
/research/agy-threads/r2/t5-official-text.tsv
/research/agy-threads/r2/frames/
# round 3: the web pages its rows cite, as fetched (third-party content; the rows quote what matters)
/research/agy-threads/r3/pages/
# later rounds: the same
/research/agy-threads/r[0-9]*/pages/
/research/agy-threads/r[0-9]*/rows/pages
# a round's own helper scripts: they only write its rows (committed), and go stale once a review corrects them
/research/agy-threads/r[0-9]*/*.py
